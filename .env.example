# =====================================================================
# Example environment configuration.
# Copy to .env and adjust. NEVER commit a real .env or any secret.
# In production, values come from AWS Secrets Manager / SSM via IAM role,
# not from a committed file (see docs/SECURITY.md).
# =====================================================================

# --- Operating mode (brief §3) ---
# Single source of truth: APP_MODE = research | production | test
#   research   (default) : original experimental behavior (fail-OPEN semantic
#                          validation / rules-only on inference error). Required
#                          for the C1–C5 ablation and evaluation scripts.
#   production            : fail-SAFE (inference errors do NOT execute commands
#                          or generate conversation; the API returns
#                          MODEL_UNAVAILABLE). Use on any public path.
#   test                 : like research; used by the unit suite.
# APP_MODE=research
#
# Legacy fallback (deprecated): if APP_MODE is unset, PRODUCTION_MODE=true /
# RESEARCH_MODE=true are still honored. Setting BOTH resolves to production
# (with a warning). Prefer APP_MODE.

# --- In-memory context safeguards (dev; Redis is the Phase 4 production store) ---
# MAX_CONTEXTS=10000        # max distinct session/rate-limit contexts held per process
# CONTEXT_TTL_MS=3600000    # idle context eviction TTL (ms)

# --- Ollama (local LLM) ---
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:1b

# --- Rate Limiting (in-process; production uses distributed Redis limiter) ---
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_MS=60000

# --- Logging ---
LOG_FILE=logs/security.log
LOG_VERBOSE=false

# --- Command Execution ---
COMMAND_TIMEOUT_MS=5000

# --- ChromaDB (RAG) ---
CHROMADB_HOST=localhost
CHROMADB_PORT=8000
CHROMADB_ENABLED=true
CHROMADB_N_RESULTS=5
CHROMADB_DISTANCE_THRESHOLD=1.0

# --- Memory System ---
SESSION_HISTORY_WINDOW=5
LONG_TERM_MEMORY_ENABLED=true
MEMORY_WARMUP_ENTRIES=10

# --- Production API (apps/api, Phase 5) ---
# NODE_ENV=development           # set to "production" behind TLS to enable HSTS + lean error logs
# API_PORT=3001
# API_CORS_ORIGINS=              # comma-separated allowlist, e.g. https://app.example.com (empty = same-origin only)
# API_BODY_LIMIT=32kb
# API_REQUEST_TIMEOUT_MS=30000
# API_MAX_MESSAGE_LENGTH=4000

# =====================================================================
# The variables below are for FUTURE production phases (not used by the
# current research CLI). They are documented here so you know exactly what
# each phase will require and where to obtain it. See docs/IMPLEMENTATION_PLAN.md.
# =====================================================================

# --- Database (Phase 2) — obtain from your Postgres/RDS instance ---
# DATABASE_URL=postgresql://user:password@host:5432/dbname?schema=public

# --- Redis (Phase 4) — obtain from your Redis/ElastiCache instance ---
# REDIS_URL=redis://host:6379

# --- Auth: Amazon Cognito (Phase 3) ---
# Obtain from AWS Console → Cognito → your User Pool.
# COGNITO_USER_POOL_ID=
# COGNITO_CLIENT_ID=
# COGNITO_REGION=
# COGNITO_JWKS_URL=

# --- Billing (Phase 7) — from your provider dashboard; pick ONE provider ---
# BILLING_PROVIDER=stripe            # stripe | moyasar | hyperpay
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# MOYASAR_SECRET_KEY=

# --- Observability (Phase 11) ---
# OTEL_EXPORTER_OTLP_ENDPOINT=
# AWS_REGION=
