# =====================================================================
# Example environment configuration.
# Copy to .env and adjust. NEVER commit a real .env or any secret.
# In production, values come from AWS Secrets Manager / SSM via IAM role,
# not from a committed file (see docs/SECURITY.md).
# =====================================================================

# --- Operating mode (brief §3) ---
# Leave both unset for Research Mode (original experimental behavior — this is
# what the C1–C5 ablation and evaluation scripts expect).
# Set PRODUCTION_MODE=true for fail-safe behavior, strict per-user isolation,
# and safe defaults. Do NOT enable RESEARCH_MODE on a public production path.
# PRODUCTION_MODE=false
# RESEARCH_MODE=true

# --- Ollama (local LLM) ---
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:1b

# --- Rate Limiting (in-process; production uses distributed Redis limiter) ---
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_MS=60000

# --- Logging ---
LOG_FILE=logs/security.log
LOG_VERBOSE=false

# --- Command Execution ---
COMMAND_TIMEOUT_MS=5000

# --- ChromaDB (RAG) ---
CHROMADB_HOST=localhost
CHROMADB_PORT=8000
CHROMADB_ENABLED=true
CHROMADB_N_RESULTS=5
CHROMADB_DISTANCE_THRESHOLD=1.0

# --- Memory System ---
SESSION_HISTORY_WINDOW=5
LONG_TERM_MEMORY_ENABLED=true
MEMORY_WARMUP_ENTRIES=10

# =====================================================================
# The variables below are for FUTURE production phases (not used by the
# current research CLI). They are documented here so you know exactly what
# each phase will require and where to obtain it. See docs/IMPLEMENTATION_PLAN.md.
# =====================================================================

# --- Database (Phase 2) — obtain from your Postgres/RDS instance ---
# DATABASE_URL=postgresql://user:password@host:5432/dbname?schema=public

# --- Redis (Phase 4) — obtain from your Redis/ElastiCache instance ---
# REDIS_URL=redis://host:6379

# --- Auth: Amazon Cognito (Phase 3) ---
# Obtain from AWS Console → Cognito → your User Pool.
# COGNITO_USER_POOL_ID=
# COGNITO_CLIENT_ID=
# COGNITO_REGION=
# COGNITO_JWKS_URL=

# --- Billing (Phase 7) — from your provider dashboard; pick ONE provider ---
# BILLING_PROVIDER=stripe            # stripe | moyasar | hyperpay
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# MOYASAR_SECRET_KEY=

# --- Observability (Phase 11) ---
# OTEL_EXPORTER_OTLP_ENDPOINT=
# AWS_REGION=
